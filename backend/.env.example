# Backend Environment Variables (.env)
# -----------------------------------

# (Required in Production) Set to true for production to enable secure cookies and disable local fallbacks.
IS_PRODUCTION=false

# (Required) The port the backend API runs on.
PORT=8080

# (Required in Production) The public-facing URL of the frontend.
# Crucial for CORS policy and email verification links.
FRONTEND_URL=http://localhost:3000

# (Required in Production) The public-facing URL of the backend.
# Used for absolute URL generation if needed.
BACKEND_URL=http://localhost:8080

# (Required) JWT Secret Key for authenticating users.
# Use a strong, random 256-bit+ string in production.
JWT_SECRET=your-secret-key

# (Optional/Required if using emails) Resend API Key for sending emails.
RESEND_API_KEY=

# (Required) PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=animevista
# Set to true to drop and recreate the DB schema on startup (DANGEROUS IN PROD!)
DB_RESET=false

# (Optional) Comma-separated list of trusted proxy IPs (e.g., 127.0.0.1, 10.0.0.0/8).
# Important if the backend is behind a reverse proxy (Nginx, Traefik, etc.) to get real client IPs.
TRUSTED_PROXIES=127.0.0.1
